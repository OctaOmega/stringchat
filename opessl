# /etc/systemd/system/flaskapp.service
# Runs a Flask app via gunicorn on 127.0.0.1:5000

[Unit]
Description=Flask App (Gunicorn)
After=network.target

[Service]
Type=simple
User=flaskapp
Group=flaskapp

WorkingDirectory=/opt/myapp
Environment="PATH=/opt/myapp/venv/bin"
Environment="FLASK_ENV=production"
# Optional app config:
# Environment="SECRET_KEY=change-me"
# Environment="DATABASE_URL=..."

# For a factory app, use "wsgi:app" where wsgi.py exposes app = create_app()
ExecStart=/opt/myapp/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:5000 --access-logfile - --error-logfile - wsgi:app

Restart=always
RestartSec=3

# Hardening (safe defaults; adjust if your app needs more)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

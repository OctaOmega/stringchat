            {% elif module.type == 'link' %}
            <div class="d-flex flex-column h-100">
                <div class="alert alert-info d-flex justify-content-between align-items-center">
                    <span>
                        <i class="fas fa-info-circle me-2"></i>
                        If the content below does not load, please open it in a new tab.
                    </span>
                    <a href="{{ module.content_url }}" target="_blank" class="btn btn-sm btn-primary">
                        <i class="fas fa-external-link-alt me-1"></i> Open in New Tab
                    </a>
                </div>
                <div class="flex-grow-1 border rounded" style="min-height: 600px;">
                    <iframe src="{{ module.content_url }}" width="100%" height="100%" style="border: none;"
                        sandbox="allow-scripts allow-same-origin allow-popups allow-forms">
                        <p>Your browser does not support iframes.</p>
                    </iframe>
                </div>
            </div>
            {% endif %}

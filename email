"""
bulk_send_html_email_via_outlook.py

Requirements:
    pip install pywin32

CSV format (header row required, example):
    primary_email,secondary_email,name,age,number,validity
    user1@example.com,alt1@example.com,Alice,30,1234567890,Valid
    user2@example.com,,Bob,45,9876543210,Expired

Usage:
    python bulk_send_html_email_via_outlook.py \
        --csv customers.csv \
        --subject "Your Account Status" \
        --sent-from "myalias@yourcompany.com" \
        --reply-to "support@yourcompany.com"
"""

import csv
import argparse
import os
import sys
import win32com.client as win32


def normalize_recipients(value):
    """Convert str or list into Outlook-style semicolon-separated string."""
    if not value:
        return ""
    if isinstance(value, str):
        return value
    return "; ".join([v for v in value if v])


def send_html_email(
    to_recipients,
    subject,
    html_body,
    cc_recipients=None,
    bcc_recipients=None,
    attachments=None,
    display_before_send=False,
    sent_from=None,
    reply_to=None,
):
    """
    Send an HTML email using the default Outlook profile.

    :param to_recipients: str or list[str]
    :param subject: str
    :param html_body: str (HTML)
    :param cc_recipients: str or list[str]
    :param bcc_recipients: str or list[str]
    :param attachments: list[str] file paths
    :param display_before_send: bool
    :param sent_from: str, email/address to show in From (SentOnBehalfOfName)
    :param reply_to: str, Reply-To address
    """
    outlook = win32.Dispatch("Outlook.Application")
    mail = outlook.CreateItem(0)  # 0 = MailItem

    mail.To = normalize_recipients(to_recipients)
    mail.CC = normalize_recipients(cc_recipients)
    mail.BCC = normalize_recipients(bcc_recipients)
    mail.Subject = subject
    mail.HTMLBody = html_body

    # Optional "From" (on behalf of). Outlook must permit this.
    if sent_from:
        mail.SentOnBehalfOfName = sent_from

    # Optional Reply-To
    if reply_to:
        # Clear default reply recipients and add our custom one
        mail.ReplyRecipients.Clear()
        mail.ReplyRecipients.Add(reply_to)

    # Attachments
    if attachments:
        for filepath in attachments:
            if os.path.isfile(filepath):
                mail.Attachments.Add(Source=filepath)
            else:
                print(f"[WARN] Attachment not found: {filepath}")

    if display_before_send:
        mail.Display()
    else:
        mail.Send()


def read_customers_from_csv(csv_path):
    """
    Read customers from CSV.

    Expected headers:
        primary_email, secondary_email, name, age, number, validity
    """
    customers = []
    with open(csv_path, mode="r", encoding="utf-8-sig", newline="") as f:
        reader = csv.DictReader(f)
        required_cols = {
            "primary_email",
            "secondary_email",
            "name",
            "age",
            "number",
            "validity",
        }
        missing = required_cols - set(reader.fieldnames or [])
        if missing:
            raise ValueError(
                f"CSV is missing required columns: {', '.join(missing)}\n"
                f"Found columns: {reader.fieldnames}"
            )

        for row in reader:
            customers.append(row)
    return customers


def build_html_body(customer):
    """
    Build a personalized HTML body for a customer row.

    customer keys:
        name, age, number, validity, primary_email, secondary_email
    """
    name = customer.get("name", "").strip()
    age = customer.get("age", "").strip()
    number = customer.get("number", "").strip()
    validity = customer.get("validity", "").strip()
    primary = customer.get("primary_email", "").strip()
    secondary = customer.get("secondary_email", "").strip()

    html_template = f"""
    <html>
      <body style="font-family: Arial, sans-serif;">
        <h2 style="color:#2d6cdf;">Hello {name},</h2>
        <p>Here are your account details:</p>

        <table border="0" cellspacing="0" cellpadding="6" style="border-collapse:collapse;">
          <tr>
            <td><b>Name</b></td><td>{name}</td>
          </tr>
          <tr>
            <td><b>Age</b></td><td>{age}</td>
          </tr>
          <tr>
            <td><b>Contact Number</b></td><td>{number}</td>
          </tr>
          <tr>
            <td><b>Primary Email</b></td><td>{primary}</td>
          </tr>
          <tr>
            <td><b>Secondary Email</b></td><td>{secondary or "-"}</td>
          </tr>
          <tr>
            <td><b>Validity</b></td><td>{validity}</td>
          </tr>
        </table>

        <p>If any of the above information is incorrect, please reply to this email.</p>

        <p>Best regards,<br>
        Your Company Team</p>
      </body>
    </html>
    """
    return html_template


def main():
    parser = argparse.ArgumentParser(
        description="Send personalized HTML emails via Outlook using a CSV file."
    )
    parser.add_argument(
        "--csv",
        required=True,
        help="Path to CSV file with customer details.",
    )
    parser.add_argument(
        "--subject",
        required=True,
        help="Subject line for the email.",
    )
    parser.add_argument(
        "--sent-from",
        default=None,
        help="Optional 'From' address (SentOnBehalfOfName). Must be allowed in Outlook.",
    )
    parser.add_argument(
        "--reply-to",
        default=None,
        help="Optional Reply-To address.",
    )
    parser.add_argument(
        "--preview",
        action="store_true",
        help="Preview each email instead of sending directly.",
    )

    args = parser.parse_args()

    if not os.path.isfile(args.csv):
        print(f"[ERROR] CSV file not found: {args.csv}")
        sys.exit(1)

    try:
        customers = read_customers_from_csv(args.csv)
    except Exception as e:
        print(f"[ERROR] Failed to read CSV: {e}")
        sys.exit(1)

    print(f"[INFO] Loaded {len(customers)} customers from {args.csv}")

    for idx, customer in enumerate(customers, start=1):
        primary = (customer.get("primary_email") or "").strip()
        secondary = (customer.get("secondary_email") or "").strip()

        if not primary:
            print(f"[WARN] Row {idx}: missing primary_email, skipping.")
            continue

        to_list = [primary]
        if secondary:
            to_list.append(secondary)

        html_body = build_html_body(customer)

        print(f"[INFO] Sending email {idx}/{len(customers)} to: {', '.join(to_list)}")

        try:
            send_html_email(
                to_recipients=to_list,
                subject=args.subject,
                html_body=html_body,
                sent_from=args.sent_from,
                reply_to=args.reply_to,
                display_before_send=args.preview,
            )
        except Exception as e:
            print(f"[ERROR] Failed to send to {', '.join(to_list)}: {e}")


if __name__ == "__main__":
    main()
